#!/usr/bin/env python3
import sys
import os
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
candidates = [
    os.path.join(SCRIPT_DIR, "..", "cli", "bin", "nilastia"),
    os.path.expanduser("~/Nilastia/cli/bin/nilastia"),
    "/usr/share/nilastia/cli/bin/nilastia"
]

REAL_CLI = None
for c in candidates:
    real_c = os.path.realpath(c)
    if os.path.exists(real_c):
        REAL_CLI = real_c
        break

def main():
    args = sys.argv[1:]
    cmd = [REAL_CLI] + args
    try:
        res = subprocess.run(cmd, stdout=sys.stdout, stderr=sys.stderr, stdin=sys.stdin)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:
        sys.stderr.write(f"Failed to execute Nilastia CLI: {e}\n")
        sys.exit(1)

if __name__ == "__main__":
    main()
